import requests

# Your NewsData.io API key
api_key = "pub_03c8eb5f640c4d14ab3664e9f32971***"

# NewsData.io endpoint
url = "https://newsdata.io/api/1/latest"

# Topics you want to fetch
topics = ["technology", "sports", "business"]

for topic in topics:
    params = {
        "apikey": api_key,   # <-- lowercase 'apikey'
        "q": topic,          # search keyword
        "country": "in",     # optional filter (India)
        "language": "en"     # English articles
    }

    response = requests.get(url, params=params)
    data = response.json()

    print("\n==============================")
    print("TOPIC:", topic)
    print("==============================")

    if "results" in data:
        for article in data["results"]:
            print("\nTitle:", article.get("title"))
            print("Source:", article.get("source_id"))
            print("URL:", article.get("link"))
    else:
        print("Error: Unexpected response")
        print("Full response:", data)
